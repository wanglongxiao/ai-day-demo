# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# ===== Byteplus TOS Object Storage =====
# Access key / secret key of a Byteplus IAM user with TOS + ModelArk access.
BYTEPLUS_AK=your-access-key
BYTEPLUS_SK=your-secret-key
TOS_REGION=cn-hongkong
TOS_BUCKET=your-tos-bucket
TOS_ENDPOINT=tos-cn-hongkong.bytepluses.com

# ===== ModelArk LLM / Image / Video models =====
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_API_KEY=your-modelark-api-key
CHAT_MODEL=your-chat-model-endpoint-id
IMAGE_MODEL=your-image-model-endpoint-id
VIDEO_MODEL=your-video-model-endpoint-id

# Fixed reference portraits (Image 2 / Image 3) registered in the asset library.
# Create these assets first (see README) and paste their asset-ids here.
REFERENCE_IMAGE_ASSET_2=asset-xxxxxxxx
REFERENCE_IMAGE_ASSET_3=asset-yyyyyyyy

# ===== Asset Library (Private Virtual Portrait Library, signed AK/SK) =====
ARK_OPENAPI_HOST=https://open.byteplusapi.com
ARK_OPENAPI_REGION=ap-southeast-1
ARK_ASSET_PROJECT=default

# ===== Server =====
HOST=0.0.0.0
PORT=8000
# Optional access password (leave blank to disable the gate)
ACCESS_PASSWORD=
